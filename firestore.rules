rules_version = '2';

// Reglas de seguridad de Firestore para el dashboard de Metegol.
//
// Cómo instalarlas: Firebase Console -> Firestore Database -> Reglas ->
// pegar este archivo entero -> Publicar. (Ver README.md, sección
// "Configurar Firebase" para el paso a paso completo.)
//
// Idea central: el rol se guarda en users/{uid}.role y estas reglas lo
// leen ahí mismo para decidir quién puede escribir. Esto es lo que hace
// que ningún jugador pueda editar nada aunque intente llamar a Firestore
// directamente desde las herramientas del navegador, sin pasar por la UI.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Perfiles de usuario (nombre, rol, playerId vinculado).
    // Cualquier usuario logueado puede leer los perfiles (para mostrar
    // nombres, por ejemplo), pero solo el admin puede crear/editar/borrar
    // usuarios. Cada usuario puede leer el suyo aunque no sea admin.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Datos del equipo: jugadores, estadísticas, caja chica, etc.
    // Todos los usuarios logueados pueden leer (ven el dashboard en vivo).
    // Solo el admin puede escribir (subir Excel, editar jugadores, etc.).
    match /team/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Historial de meses cerrados (snapshots que useTeamStore.importPlayers
    // archiva automáticamente antes de pisar team/main con un mes nuevo).
    // Mismo esquema que team/: todos leen, solo el admin escribe (la
    // escritura la hace el propio import, ejecutado siempre por el admin).
    match /history/{monthId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Contrato del equipo: todos lo leen, solo el admin lo edita.
    match /contract/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Aceptación individual del contrato (uno por usuario). Cada usuario
    // puede leer y escribir SOLO su propio documento; el admin además
    // puede leer todos (para ver quién aceptó y quién está pendiente),
    // pero no puede escribirlos en nombre de otro.
    match /contractAcceptances/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    function isVotingOpen() {
      return exists(/databases/$(database)/documents/votingStatus/main) &&
        get(/databases/$(database)/documents/votingStatus/main).data.open == true;
    }

    function hasNotVoted() {
      return !exists(/databases/$(database)/documents/votes/$(request.auth.uid));
    }

    // Estado de la votación (abierta/cerrada). Cualquiera logueado puede
    // leerlo -lo necesita para saber si mostrar la papeleta o los
    // resultados- pero nunca expone conteos. Solo el admin la abre/cierra.
    match /votingStatus/main {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cuánta gente ya votó (X de Y). Lectura exclusiva del admin: nunca
    // dice a quién votó cada uno, solo un contador. Cualquier usuario que
    // todavía no votó puede incrementarlo en +1 al emitir su voto (el
    // cliente hace esta escritura junto con la creación de votes/{uid}).
    //
    // Endurecido: además de la condición original (logueado, votación
    // abierta, todavía no votó), ahora se exige que la escritura toque
    // ÚNICAMENTE el campo votedCount y que el nuevo valor sea exactamente
    // el anterior + 1. Así un usuario no puede, antes de votar, pisar el
    // contador con un valor arbitrario ni agregar campos ajenos al
    // documento; solo puede hacer el mismo incremento atómico de +1 que ya
    // hace la app (updateDoc(..., { votedCount: increment(1) })).
    match /votingParticipation/main {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isVotingOpen() && hasNotVoted() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount']) &&
         request.resource.data.votedCount == resource.data.votedCount + 1);
      allow delete: if isAdmin();
    }

    // Conteos agregados por candidato. Mientras la votación está abierta,
    // NADIE puede leerlos (ni jugadores ni admin): solo se pueden leer una
    // vez cerrada. La escritura (incrementar el conteo del candidato
    // elegido) está permitida a cualquier usuario que todavía no emitió su
    // voto, igual que arriba.
    //
    // Endurecido: se restringe la escritura de un usuario no-admin a tocar
    // ÚNICAMENTE los campos captainCounts/subcaptainCounts (no puede
    // reescribir otros campos ni cambiar la forma del documento). Esto
    // reduce el margen de manipulación frente a la regla anterior, que
    // permitía cualquier update al documento completo mientras no hubiera
    // votado. Una validación exacta de "solo +1 a una sola clave dentro
    // del mapa" requeriría comparar mapas anidados, algo frágil de
    // expresar en este lenguaje de reglas sin arriesgar bloquear votos
    // legítimos; queda documentado como mejora futura (mover el conteo a
    // una Cloud Function con Admin SDK).
    match /voteResults/main {
      allow read: if isSignedIn() && !isVotingOpen();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isVotingOpen() && hasNotVoted() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captainCounts', 'subcaptainCounts']));
      allow delete: if isAdmin();
    }

    // Voto individual de cada usuario. Solo el propio dueño puede leerlo
    // (ni siquiera el admin): así se garantiza que nadie sepa a quién votó
    // cada quien. Es de creación única -no se puede editar ni borrar una
    // vez emitido-, salvo que el admin lo borre para reiniciar una ronda
    // (eso no revela el contenido del voto, solo limpia el "ya voté").
    match /votes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isVotingOpen() &&
        request.resource.data.captainId is string &&
        request.resource.data.subcaptainId is string &&
        request.resource.data.captainId != request.resource.data.subcaptainId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Votacion de Figura y Casco de la fecha ----
    //
    // Mismo patron que Capitan arriba (ronda global unica, sin entidad de
    // fecha/partido), duplicado x2 (figura, casco) para que sus estados
    // nunca se mezclen. Capitan NO se toca: sigue usando exactamente las
    // reglas de arriba, sin cambios.
    //
    // Diferencia deliberada respecto de voteResults/main de Capitan:
    // figuraVoteResults/main y cascoVoteResults/main son de lectura
    // EXCLUSIVA del admin, SIEMPRE -nunca de un jugador, ni siquiera una
    // vez cerrada la votacion (Capitan si deja leer voteResults/main a
    // cualquier usuario logueado una vez cerrada). Es asi porque se pidio
    // explicitamente que ningun jugador vea cantidades de votos en ningun
    // momento; el resultado (sin cantidades) se expone aparte en
    // <type>VotingStatus/main.winnerIds, que si es publico.
    //
    // Limite ya conocido y aceptado (igual que en voteResults/main de
    // Capitan, documentado ahi mismo arriba): la escritura no-admin de
    // "counts" valida que solo se toque ese campo, pero no valida la
    // magnitud exacta del incremento -queda como mejora futura (Cloud
    // Function con Admin SDK), en paridad con la limitacion ya aceptada de
    // Capitan.

    function isFiguraVotingOpen() {
      return exists(/databases/$(database)/documents/figuraVotingStatus/main) &&
        get(/databases/$(database)/documents/figuraVotingStatus/main).data.open == true;
    }

    function hasNotVotedFigura() {
      return !exists(/databases/$(database)/documents/figuraVotes/$(request.auth.uid));
    }

    function isCascoVotingOpen() {
      return exists(/databases/$(database)/documents/cascoVotingStatus/main) &&
        get(/databases/$(database)/documents/cascoVotingStatus/main).data.open == true;
    }

    function hasNotVotedCasco() {
      return !exists(/databases/$(database)/documents/cascoVotes/$(request.auth.uid));
    }

    match /figuraVotingStatus/main {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /figuraVotingParticipation/main {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isFiguraVotingOpen() && hasNotVotedFigura() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount']) &&
         request.resource.data.votedCount == resource.data.votedCount + 1);
      allow delete: if isAdmin();
    }

    match /figuraVoteResults/main {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isFiguraVotingOpen() && hasNotVotedFigura() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']));
      allow delete: if isAdmin();
    }

    match /figuraVotes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isFiguraVotingOpen() &&
        request.resource.data.twoVotesPlayerId is string &&
        request.resource.data.oneVotePlayerId is string &&
        request.resource.data.twoVotesPlayerId != request.resource.data.oneVotePlayerId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /cascoVotingStatus/main {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cascoVotingParticipation/main {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isCascoVotingOpen() && hasNotVotedCasco() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount']) &&
         request.resource.data.votedCount == resource.data.votedCount + 1);
      allow delete: if isAdmin();
    }

    match /cascoVoteResults/main {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && isCascoVotingOpen() && hasNotVotedCasco() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']));
      allow delete: if isAdmin();
    }

    match /cascoVotes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isCascoVotingOpen() &&
        request.resource.data.twoVotesPlayerId is string &&
        request.resource.data.oneVotePlayerId is string &&
        request.resource.data.twoVotesPlayerId != request.resource.data.oneVotePlayerId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Fecha/Partido (Fase 2, Bloque 1) ----
    //
    // Reemplaza el stub anterior ("si se usa a futuro"). Por ahora solo
    // cubre la entidad Fecha en sí (crear/listar/cerrar) -playerStats
    // (Bloque 2) y Figura/Casco por fecha (Bloque 3) se agregan en sus
    // propios bloques, con sus propias reglas namespaced bajo
    // matches/{matchId}. La votación de Capitán/Subcapitán NO pasa por
    // acá: sigue siendo la ronda global de toda la temporada
    // (votingStatus/main y compañía, arriba, sin cambios).

    // matchNumbers/{number}: reserva PERMANENTE de un número de fecha.
    // Mismo mecanismo de "creación única" que ya usa votes/{uid} para
    // bloquear el doble voto (existencia de un documento como prueba de
    // unicidad), aplicado acá a "number" en vez de a "uid". Sin delete
    // nunca -ni admin-, para que no pueda quedar un número liberado
    // mientras el matches/{matchId} correspondiente siga existiendo (y
    // los matches tampoco se pueden borrar, ver más abajo). Una
    // corrección de un número mal tipeado queda, a propósito, fuera de
    // este bloque: sería una operación administrativa aparte que
    // mantenga consistencia entre ambos documentos.
    match /matchNumbers/{number} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // Documento de cada fecha. Nunca contiene conteos de votos ni datos
    // sensibles -por eso es seguro que cualquier usuario logueado lo lea
    // completo. La escritura es 100% admin. Sin delete: una fecha ya
    // creada queda para siempre.
    //
    // "status: closed" es, a propósito, un bloqueo duro: los Bloques 2 y
    // 3 van a exigir en SUS PROPIAS reglas (playerStats, votos de
    // Figura/Casco) que este documento tenga status == "open" antes de
    // permitir escribir -acá en Bloque 1 no hay todavía ningún otro
    // recurso que bloquear, solo el propio match.
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == "open" &&
        request.resource.data.number is int &&
        request.resource.data.date is string;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- Bloque 2: playerStats por fecha ----
    //
    // Estadísticas de un jugador en UNA fecha puntual. Lectura pública
    // (igual que team/main hoy), escritura 100% admin Y con la fecha
    // todavía abierta -bloqueo duro server-side, no solo en la UI: una vez
    // que matches/{matchId}.status == "closed", ni el admin puede
    // crear/actualizar/borrar playerStats de esa fecha. Mismo nivel de
    // confianza que team/main hoy: no se valida la forma de cada campo,
    // solo quién y en qué estado de la fecha puede escribir.
    function isMatchOpen(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId)).data.status == "open";
    }

    match /matches/{matchId}/playerStats/{playerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isMatchOpen(matchId);
    }

    // ---- Bloque 3: Figura y Casco por fecha ----
    //
    // Mismo espíritu que Capitán y que la versión global de Figura/Casco
    // arriba (sin tocar ninguna de las dos), namespaced bajo
    // matches/{matchId} y reutilizando isMatchOpen(matchId) ya definida
    // arriba para Bloque 2. Un solo admin en este sistema -sin necesidad
    // de proteger contra dos admins concurrentes-, pero igual se restringe
    // cada escritura, incluso la del admin, a tocar únicamente los campos
    // que ese documento puede tener: votedCount/counts no se pueden pisar
    // con un valor arbitrario aprovechando un "allow write: if isAdmin()"
    // genérico.
    function isFiguraOpen(matchId) {
      return isMatchOpen(matchId) &&
        exists(/databases/$(database)/documents/matches/$(matchId)/figuraStatus/main) &&
        get(/databases/$(database)/documents/matches/$(matchId)/figuraStatus/main).data.open == true;
    }
    function hasNotVotedFiguraFecha(matchId) {
      return !exists(/databases/$(database)/documents/matches/$(matchId)/figuraVotes/$(request.auth.uid));
    }
    function isCascoOpen(matchId) {
      return isMatchOpen(matchId) &&
        exists(/databases/$(database)/documents/matches/$(matchId)/cascoStatus/main) &&
        get(/databases/$(database)/documents/matches/$(matchId)/cascoStatus/main).data.open == true;
    }
    function hasNotVotedCascoFecha(matchId) {
      return !exists(/databases/$(database)/documents/matches/$(matchId)/cascoVotes/$(request.auth.uid));
    }

    // figuraStatus: "cerrar" (open == false) siempre está permitido al
    // admin, sin importar el estado de la fecha -evita un callejón sin
    // salida si la fecha se cerró mientras esta votación seguía
    // técnicamente abierta (no se fuerza figuraOpen a false en cascada al
    // cerrar la fecha). "Abrir"/reabrir (open == true) sí exige que la
    // fecha esté abierta. Los votos igual quedan bloqueados en ese
    // escenario porque isFiguraOpen() chequea isMatchOpen() aparte.
    match /matches/{matchId}/figuraStatus/main {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['open', 'closedAt']) &&
        request.resource.data.open == true;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'closedAt']) &&
        (request.resource.data.open == false || isMatchOpen(matchId));
      allow delete: if false;
    }

    match /matches/{matchId}/figuraParticipation/main {
      allow read: if isAdmin();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['votedCount']) &&
        request.resource.data.votedCount == 0;
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount'])) ||
        (isSignedIn() && isFiguraOpen(matchId) && hasNotVotedFiguraFecha(matchId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount']) &&
         request.resource.data.votedCount == resource.data.votedCount + 1);
      allow delete: if isAdmin();
    }

    match /matches/{matchId}/figuraVoteResults/main {
      allow read: if isAdmin();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['counts']) &&
        request.resource.data.counts == {};
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts'])) ||
        (isSignedIn() && isFiguraOpen(matchId) && hasNotVotedFiguraFecha(matchId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']));
      allow delete: if isAdmin();
    }

    match /matches/{matchId}/figuraVotes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isFiguraOpen(matchId) &&
        request.resource.data.keys().hasOnly(['twoVotesPlayerId', 'oneVotePlayerId', 'votedAt']) &&
        request.resource.data.twoVotesPlayerId is string &&
        request.resource.data.oneVotePlayerId is string &&
        request.resource.data.twoVotesPlayerId != request.resource.data.oneVotePlayerId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /matches/{matchId}/cascoStatus/main {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['open', 'closedAt']) &&
        request.resource.data.open == true;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'closedAt']) &&
        (request.resource.data.open == false || isMatchOpen(matchId));
      allow delete: if false;
    }

    match /matches/{matchId}/cascoParticipation/main {
      allow read: if isAdmin();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['votedCount']) &&
        request.resource.data.votedCount == 0;
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount'])) ||
        (isSignedIn() && isCascoOpen(matchId) && hasNotVotedCascoFecha(matchId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCount']) &&
         request.resource.data.votedCount == resource.data.votedCount + 1);
      allow delete: if isAdmin();
    }

    match /matches/{matchId}/cascoVoteResults/main {
      allow read: if isAdmin();
      allow create: if isAdmin() && isMatchOpen(matchId) &&
        request.resource.data.keys().hasOnly(['counts']) &&
        request.resource.data.counts == {};
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts'])) ||
        (isSignedIn() && isCascoOpen(matchId) && hasNotVotedCascoFecha(matchId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']));
      allow delete: if isAdmin();
    }

    match /matches/{matchId}/cascoVotes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isCascoOpen(matchId) &&
        request.resource.data.keys().hasOnly(['twoVotesPlayerId', 'oneVotePlayerId', 'votedAt']) &&
        request.resource.data.twoVotesPlayerId is string &&
        request.resource.data.oneVotePlayerId is string &&
        request.resource.data.twoVotesPlayerId != request.resource.data.oneVotePlayerId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Por defecto, todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
